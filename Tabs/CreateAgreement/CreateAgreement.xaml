<Page x:Class="Reports.Tabs.CreateAgreement.CreateAgreement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Reports.Controls"
             FlowDirection="RightToLeft"
             d:DesignHeight="400"
             d:DesignWidth="300"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             mc:Ignorable="d"
             >
 <Grid Margin="5" VerticalAlignment="Top" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Card with form -->
        <ui:Card Grid.Row="1" Padding="20" Margin="0,0,0,10" Background="Transparent" Visibility="{Binding View.InputPanelVisibility}">
            <Grid Grid.IsSharedSizeScope="True" FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <!-- Pair #1 -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Regular Text Fields -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="לינק קייס:" VerticalAlignment="Center" Margin="0,5,8,0"/>
                <controls:FuzzyUrlComboBox Grid.Row="0" Grid.Column="1"
                                           x:Name="Url"
                                           ItemsSource="{Binding SyncStore.TabUrls}"
                                           Text="{Binding View.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                
                <!-- Submit Button -->
                <ui:Button Content="יצא" Grid.Row="1" Grid.Column="1"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Stretch"
                        IsDefault="True"
                        Click="Submit_Click"
                        MaxWidth="150"
                        Appearance="Primary"
                        Cursor="Hand"
                        FontWeight="Bold"/>
                
            </Grid>
        </ui:Card>
        <ui:Card Grid.Row="1"
                 Padding="20"
                 Margin="0,0,0,10"
                 Background="Transparent"
                 Visibility="{Binding View.DataPanelVisibility}"
                 FlowDirection="RightToLeft">

            <!-- One grid = consistent alignment for all rows -->
            <Grid Grid.IsSharedSizeScope="True" FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <!-- Pair #1 -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" />
                    <!-- Gap -->
                    <ColumnDefinition Width="20" />
                    <!-- Pair #2 -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="שם מלא:" VerticalAlignment="Center" Margin="0,5,8,0"/>
                <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding View.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" HorizontalAlignment="Stretch" TextAlignment="Right"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="תאריך יצירה:" VerticalAlignment="Center" Margin="0,5,8,0"/>
                <ui:TextBox Grid.Row="0" Grid.Column="4" Text="{Binding View.CreatedOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" HorizontalAlignment="Stretch" TextAlignment="Right"/>
                
                
                <ui:Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                           Content="שלח נתונים"
                           Margin="4,20,0,0"
                           HorizontalAlignment="Stretch"
                           Appearance="Primary"
                           FontWeight="Bold"
                           MaxWidth="250"
                           Cursor="Hand"
                           Click="SendFinal_Click"/>
                <ui:Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Content="חזור"
                           Margin="4,20,0,0"
                           HorizontalAlignment="Stretch"
                           Appearance="Secondary"
                           Cursor="Hand"
                           Click="PreviousPage_Click"/>
            </Grid>
        </ui:Card>
        <controls:LoadingOverlay x:Name="Loading"
                                 Grid.Row="0"
                                 Grid.RowSpan="2"
                                 IsCancelable="False"
                                 MinimumShowTimeMilliseconds="250"/>
        <controls:OverlayBanner x:Name="Overlay" Grid.Row="0"
                                />

    </Grid>
</Page>
